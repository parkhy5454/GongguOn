
// server.js (Socket.io)에 추가 - 채팅 도배 방지

io.use((socket, next) => {
  socket.data.messageTimestamps = [];
  next();
});

io.on('connection', (socket) => {
  socket.on('chat:message', async (data) => {
    const now = Date.now();
    socket.data.messageTimestamps = socket.data.messageTimestamps.filter(t => now - t < 10000); // 10초 윈도우
    if (socket.data.messageTimestamps.length >= 3) {
      socket.emit('chat:error', { message: '도배 방지: 10초에 3개까지만 보낼 수 있어요' });
      return;
    }
    socket.data.messageTimestamps.push(now);
    // ... 기존 메시지 처리
  });
});
