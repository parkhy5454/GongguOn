generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  defaultAddress String?
  agreedAt     DateTime?
  passwordHash String
  createdAt    DateTime @default(now())

  referralCode String   @unique
  referredById String?
  referredBy   User?    @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referral")

  pointBalance Int      @default(0)
  firstPurchaseRewardGiven Boolean @default(false)
  firstEventRewardGiven    Boolean @default(false)

  hostedEvents Event[]   @relation("Host")
  orders       Order[]
  messages     EventMessage[]
  reviewsGiven    Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Target")
  reports         Report[]
  notifications   Notification[]
  passwordResetTokens PasswordResetToken[]
}

enum EventStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum DeliveryStatus {
  PREPARING
  SHIPPING
  DONE
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  images      String[] @default([])
  minQuantity Int      @default(1)
  deadline    DateTime
  status      EventStatus    @default(OPEN)
  deliveryStatus DeliveryStatus @default(PREPARING)
  aiAutoReply Boolean  @default(false)
  deadlineReminderSent Boolean @default(false)
  createdAt   DateTime @default(now())

  hostId      String
  host        User     @relation("Host", fields: [hostId], references: [id])

  options     EventOption[]
  orders      Order[]
  messages    EventMessage[]
  reviews     Review[]
  discountTiers DiscountTier[]
  reports     Report[]
}

model DiscountTier {
  id              String @id @default(cuid())
  eventId         String
  event           Event  @relation(fields: [eventId], references: [id])
  minParticipants Int
  discountPercent Int
}

model Report {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  reporterId String
  reporter  User     @relation(fields: [reporterId], references: [id])
  reason    String
  detail    String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EventOption {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id])
  name      String
  price     Int
  stock     Int
  soldCount Int     @default(0)

  orders    Order[]
}

enum PaymentStatus {
  PENDING
  PAID
  CONFIRMED
}

model Order {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  optionId       String
  option         EventOption   @relation(fields: [optionId], references: [id])
  buyerId        String
  buyer          User          @relation(fields: [buyerId], references: [id])
  quantity       Int
  amount         Int
  discountPercent Int          @default(0)
  pointsUsed     Int           @default(0)
  shippingAddress String?
  depositorName  String?
  paymentMethod  String        @default("BANK_TRANSFER")
  tossPaymentKey String?
  trackingCompany String?
  trackingNumber String?
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

model EventMessage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  reviewerId String
  reviewer  User     @relation("Reviewer", fields: [reviewerId], references: [id])
  targetId  String
  target    User     @relation("Target", fields: [targetId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([eventId, reviewerId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
