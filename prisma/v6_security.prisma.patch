
/// v6 - 보안 + 에스크로 + 등급제

model Order {
  // ... 기존 ...
  isConfirmed     Boolean   @default(false)
  confirmedAt     DateTime?
  carrier         String?
  trackingNumber  String?
  shippingStatus  String    @default("PREPARING") // PREPARING, SHIPPING, DELIVERED, CONFIRMED
  shippedAt       DateTime?
  sellerId        String? // 판매자 ID (정산용)
}

model SettlementQueue {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  sellerId  String
  amount    Int
  status    String   @default("READY") // READY, PAID
  createdAt DateTime @default(now())
  paidAt    DateTime?
}

model Report {
  id        String   @id @default(cuid())
  productId String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  @@unique([productId, userId])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // PRICE_TAMPER, CHAT_SPAM, etc
  detail    String   @db.Text
  ip        String?
  createdAt DateTime @default(now())
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  subscription String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

